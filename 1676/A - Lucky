import java.util.Scanner;
public class ALucky{
    static public void main(String[] args){
        Scanner input = new Scanner(System.in);
        int x = input.nextInt();
        while(x-- > 0){
            String s = input.next();
            System.out.println((s.charAt(0)+s.charAt(1)+s.charAt(2) == s.charAt(3)+s.charAt(4)+s.charAt(5)) ? "YES" : "NO");
        }
        input.close();
    }
}